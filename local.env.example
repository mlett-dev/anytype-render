# Copy to local.env and fill in. local.env is git-ignored.

# The anytype-cli container whose heart the renderer joins (network namespace,
# session token, account id).
AR_CLI_CONTAINER=

# For scripts/smoke.sh: the anytype-extension-mcp checkout's livetest
# directory, the launcher that starts the MCP server on stdio, and the host
# directory shared with the Anytype server (see the MCP's livetest README).
AEM_LIVETEST_DIR=
ANYTYPE_MCP_LAUNCHER=
ANYTYPE_LIVETEST_SHARED_ROOT=
