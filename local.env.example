# Copy to local.env and fill in. local.env is git-ignored.

# The anytype-cli container whose heart the renderer joins (network namespace,
# session token, account id).
AR_CLI_CONTAINER=

# For scripts/smoke.sh: the anytype-extension-mcp checkout's livetest
# directory, the launcher that starts the MCP server on stdio, and the host
# directory shared with the Anytype server, and the space the test objects go
# into: one only this account is a member of (see the MCP's livetest README).
AEM_LIVETEST_DIR=
ANYTYPE_MCP_LAUNCHER=
ANYTYPE_LIVETEST_SHARED_ROOT=
ANYTYPE_LIVETEST_SPACE_ID=

# Optional, for a test instance next to the production one (README, Updating):
# AR_TAG=test AR_NAME=anytype-render-test AR_APP_PORT=31098 AR_API_PORT=31099
# AR_DEV_SRC=1 mounts this checkout's service/src into the container.
