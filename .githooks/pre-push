#!/usr/bin/env bash
# Last gate before publishing: every commit the push would add, including ones
# made with --no-verify or before these hooks existed (added lines + messages).
set -uo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check-private.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch publishes nothing
  if [ "$remote_sha" = "$zero" ]; then
    # New branch: everything not already on the remote.
    range="$local_sha --not --remotes"
    commits=$(git rev-list $range)
    [ -z "$commits" ] && continue
    first=$(printf '%s\n' "$commits" | tail -1)
    if git rev-parse -q --verify "$first^" >/dev/null; then
      range="$first^..$local_sha"
    else
      range="$local_sha"            # root commit: the whole history
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  echo "pre-push: checking $range"
  "$check" --range "$range" || status=1
done
exit $status
